{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dericbourg.dev/schemas/cv.schema.json",
  "title": "CV data",
  "description": "Shape of data/cv.yaml, consumed by layouts/_default/cv.html and layouts/partials/schema-person.html.",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "experiences", "education", "skills", "spokenLanguages"],
  "properties": {
    "header": {
      "type": "object",
      "description": "Identity block. Every field is dereferenced unconditionally by schema-person.html.",
      "additionalProperties": false,
      "required": ["name", "title", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/i18n" },
        "summary": { "$ref": "#/$defs/i18n" }
      }
    },

    "experiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company", "roles"],
        "properties": {
          "company": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "tags": { "$ref": "#/$defs/tags" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "start"],
              "properties": {
                "role": { "$ref": "#/$defs/i18n" },
                "department": { "type": "string", "minLength": 1 },
                "start": { "$ref": "#/$defs/date" },
                "end": { "$ref": "#/$defs/date" },
                "description": { "$ref": "#/$defs/i18n" },
                "tags": { "$ref": "#/$defs/tags" }
              }
            }
          },
          "extra": {
            "type": "array",
            "description": "Cross-team contributions, rendered under the company's roles.",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["topic"],
              "properties": {
                "topic": { "$ref": "#/$defs/i18n" },
                "start": { "$ref": "#/$defs/date" },
                "end": { "$ref": "#/$defs/date" },
                "description": { "$ref": "#/$defs/i18n" }
              }
            }
          }
        }
      }
    },

    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["school"],
        "properties": {
          "school": { "type": "string", "minLength": 1 },
          "degree": { "$ref": "#/$defs/i18n" },
          "location": { "type": "string", "minLength": 1 },
          "start": { "$ref": "#/$defs/date" },
          "end": { "$ref": "#/$defs/date" }
        }
      }
    },

    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "items"],
        "properties": {
          "group": { "$ref": "#/$defs/i18n" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "spokenLanguages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "$ref": "#/$defs/i18n" },
          "level": {
            "description": "Must be a key of data/cv_levels.yaml — cv.html looks it up with `index` and hard-fails otherwise.",
            "enum": ["beginner", "intermediate", "fluent", "native"]
          }
        }
      }
    }
  },

  "$defs": {
    "i18n": {
      "type": "object",
      "description": "Both languages are required: the site has no fallback, a missing one renders empty.",
      "additionalProperties": false,
      "required": ["fr", "en"],
      "properties": {
        "fr": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "date": {
      "description": "`YYYY` or `YYYY-MM`, as a string: cv.html splits it on `-` and cv-format-date.html branches on its length, so an unquoted (integer) year breaks the build.",
      "type": "string",
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2]))?$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
